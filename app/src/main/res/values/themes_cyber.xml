<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

	<!--
	  Cyber Terminal theme (ported from SQL Reader).
	  ThemeOverlay.Kotatsu.Cyber is the shared base; each ThemeOverlay.Kotatsu.Cyber.<Accent> below only
	  swaps the accent palette. The overlay is dark-only: the app forces night mode.
	-->
	<style name="ThemeOverlay.Kotatsu.Cyber" parent="ThemeOverlay.Kotatsu">
		<!-- Monospace terminal typography (sizes/weights live in the TextAppearance.Kotatsu.* styles) -->
		<item name="android:fontFamily">monospace</item>
		<item name="fontFamily">monospace</item>

		<!-- HUD shapes: cut corners instead of rounded ones -->
		<item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Kotatsu.Cyber.CornerExtraSmall</item>
		<item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Kotatsu.Cyber.CornerSmall</item>
		<item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Kotatsu.Cyber.CornerMedium</item>
		<item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Kotatsu.Cyber.CornerLarge</item>
		<item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Kotatsu.Cyber.CornerExtraLarge</item>

		<!-- Outlined "terminal panel" cards -->
		<item name="materialCardViewStyle">@style/Widget.Kotatsu.Cyber.Card</item>

		<!-- Always light system-bar icons: the theme is dark -->
		<item name="android:windowLightStatusBar" tools:targetApi="M">false</item>
	</style>

	<style name="ShapeAppearance.Kotatsu.Cyber.CornerExtraSmall" parent="">
		<item name="cornerFamily">cut</item>
		<item name="cornerSize">2dp</item>
	</style>

	<style name="ShapeAppearance.Kotatsu.Cyber.CornerSmall" parent="">
		<item name="cornerFamily">cut</item>
		<item name="cornerSize">4dp</item>
	</style>

	<!-- Same silhouette as CyberCard in SQL Reader: top-start and bottom-end corners are cut. -->
	<style name="ShapeAppearance.Kotatsu.Cyber.CornerMedium" parent="">
		<item name="cornerFamily">cut</item>
		<item name="cornerSize">0dp</item>
		<item name="cornerSizeTopLeft">8dp</item>
		<item name="cornerSizeBottomRight">8dp</item>
	</style>

	<style name="ShapeAppearance.Kotatsu.Cyber.CornerLarge" parent="">
		<item name="cornerFamily">cut</item>
		<item name="cornerSize">0dp</item>
		<item name="cornerSizeTopLeft">12dp</item>
		<item name="cornerSizeBottomRight">12dp</item>
	</style>

	<style name="ShapeAppearance.Kotatsu.Cyber.CornerExtraLarge" parent="">
		<item name="cornerFamily">cut</item>
		<item name="cornerSize">0dp</item>
		<item name="cornerSizeTopLeft">16dp</item>
		<item name="cornerSizeBottomRight">16dp</item>
	</style>

	<!-- Windows (dialogs, sheets): all four corners cut, like the "Last position" pill. -->
	<style name="ShapeAppearance.Kotatsu.Cyber.Window" parent="">
		<item name="cornerFamily">cut</item>
		<item name="cornerSize">@dimen/window_cut_size</item>
	</style>

	<style name="Widget.Kotatsu.Cyber.Card" parent="Widget.Material3.CardView.Outlined">
		<item name="strokeColor">?attr/colorOutline</item>
		<item name="strokeWidth">1dp</item>
		<item name="cardElevation">0dp</item>
	</style>


