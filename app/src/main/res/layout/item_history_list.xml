<?xml version="1.0" encoding="utf-8"?>
<!-- History screen, "compact list" mode: outlined card, three text tiers
     (title / chapter / meta), a progress bar and a delete button in the top-right corner. Outer spacing lives in the layout because
     TypedListSpacingDecoration adds none for MANGA_LIST. -->
<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginHorizontal="12dp"
	android:layout_marginVertical="5dp"
	android:clickable="true"
	android:focusable="true"
	app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
	app:rippleColor="@color/selector_overlay">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="10dp">

		<org.koitharu.kotatsu.image.ui.CoverImageView
			android:id="@+id/imageView_cover"
			android:layout_width="76dp"
			android:layout_height="114dp"
			android:background="?colorSurfaceContainer"
			app:aspectRationHeight="0"
			app:aspectRationWidth="0"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Kotatsu.Cover"
			app:trimImage="true"
			tools:src="@tools:sample/backgrounds/scenic" />

		<ImageView
			android:id="@+id/imageView_pin"
			android:layout_width="20dp"
			android:layout_height="20dp"
			android:layout_margin="2dp"
			android:background="@drawable/bg_pin_badge"
			android:padding="3dp"
			android:src="@drawable/ic_pin_small"
			android:visibility="gone"
			app:layout_constraintEnd_toEndOf="@id/imageView_cover"
			app:layout_constraintTop_toTopOf="@id/imageView_cover"
			app:tint="@android:color/white"
			tools:ignore="ContentDescription"
			tools:visibility="visible" />

		<LinearLayout
			android:id="@+id/layout_content"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:layout_marginStart="12dp"
			android:layout_marginEnd="0dp"
			android:orientation="vertical"
			app:layout_constraintBottom_toBottomOf="@id/imageView_cover"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/imageView_cover"
			app:layout_constraintTop_toTopOf="@id/imageView_cover">

			<TextView
				android:id="@+id/textView_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginEnd="38dp"
				android:ellipsize="end"
				android:maxLines="2"
				android:textAppearance="@style/TextAppearance.Kotatsu.HistoryTitleCompact"
				android:textColor="?attr/colorOnSurface"
				tools:text="Surviving as a Genius on Borrowed Time" />

			<LinearLayout
				android:id="@+id/layout_chapter"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/textView_chapter_tag"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_history_tag"
					android:paddingHorizontal="7dp"
					android:paddingVertical="2dp"
					android:textAppearance="@style/TextAppearance.Kotatsu.HistoryChapterTag"
					android:textColor="?attr/colorOnPrimary"
					tools:text="CH 42" />

				<TextView
					android:id="@+id/textView_chapter_name"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="9dp"
					android:layout_weight="1"
					android:ellipsize="end"
					android:maxLines="1"
					android:textAppearance="@style/TextAppearance.Kotatsu.HistoryChapterCompact"
					android:textColor="?attr/colorOnSurface"
					tools:text="The Return of the Genius" />

			</LinearLayout>

			<View
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<ImageView
					android:layout_width="13dp"
					android:layout_height="13dp"
					android:src="@drawable/ic_history"
					app:tint="?attr/colorOnSurfaceVariant"
					tools:ignore="ContentDescription" />

				<TextView
					android:id="@+id/textView_time"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="4dp"
					android:ellipsize="end"
					android:maxLines="1"
					android:textAppearance="@style/TextAppearance.Kotatsu.HistoryMeta"
					android:textColor="?attr/colorOnSurfaceVariant"
					tools:text="Vor 6 Stunden" />

				<TextView
					android:id="@+id/textView_source"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:layout_weight="1"
					android:ellipsize="end"
					android:gravity="end"
					android:maxLines="1"
					android:textAppearance="@style/TextAppearance.Kotatsu.HistoryTag"
					android:textColor="?attr/colorOutline"
					tools:text="ASURASCANS" />

				<TextView
					android:id="@+id/textView_percent"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:textAppearance="@style/TextAppearance.Kotatsu.HistoryPercent"
					android:textColor="?attr/colorPrimary"
					tools:text="64%" />

			</LinearLayout>

			<com.google.android.material.progressindicator.LinearProgressIndicator
				android:id="@+id/progressBar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:max="100"
				app:indicatorColor="?attr/colorPrimary"
				app:trackColor="?attr/colorOutlineVariant"
				app:trackCornerRadius="0dp"
				app:trackThickness="5dp"
				tools:progress="64" />

		</LinearLayout>

		<!-- New-chapters counter sits on the cover so the top-right corner belongs to the delete button. -->
		<org.koitharu.kotatsu.core.ui.widgets.BadgeView
			android:id="@+id/badge"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_margin="2dp"
			android:visibility="gone"
			app:layout_constraintStart_toStartOf="@id/imageView_cover"
			app:layout_constraintTop_toTopOf="@id/imageView_cover"
			app:maxCharacterCount="@integer/manga_badge_max_character_count"
			tools:number="8"
			tools:visibility="visible" />

		<!-- Delete: removes the title from history (undo is offered in a snackbar). -->
		<ImageButton
			android:id="@+id/button_remove"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:background="@drawable/bg_history_remove"
			android:contentDescription="@string/remove_from_history"
			android:padding="7dp"
			android:scaleType="fitCenter"
			android:src="@drawable/ic_delete"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			app:tint="?attr/colorError"
			tools:ignore="TouchTargetSizeCheck" />

	</androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
